<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android only grants USB access to a video-class device to apps that hold
         the camera permission, even though Link Cam never opens the phone's own
         cameras through it. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- To read ISO, aperture and shutter from the camera body over Wi-Fi.
         Link Cam talks to nothing else on the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To send those requests over the camera's Wi-Fi when it has no internet. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- To join the camera's own Wi-Fi for Link Cam, after the user confirms. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Monitoring needs USB host, but the test pattern works without it, so
         devices without host mode can still install the app. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".LinkCamApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinkCam">

        <!-- Landscape only, either way up: on a rig the phone turns with the
             camera, and the monitor must never flip to portrait or show the
             picture upside down. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Offer to open Link Cam when a capture device is plugged in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>
    </application>
</manifest>
