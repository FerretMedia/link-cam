{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "Merging this releases Link Cam. It tags the version, builds the APK and the iPad app, and publishes the GitHub release.",
  "changelog-sections": [
    { "type": "feat", "section": "New" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Faster" },
    { "type": "revert", "section": "Reverted" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "refactor", "section": "Code", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "link-cam",
      "version-file": "VERSION",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
